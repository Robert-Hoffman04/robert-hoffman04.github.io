---
import '../styles/global.css';

import PageStack from '../components/PageStack.astro';
import HomePage from '../components/sections/Home.astro';
import ProjectsPage from '../components/sections/Projects.astro';
import ContactPage from '../components/sections/Contact.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>Robert Hoffman</title>
  </head>
  <body>
	<PageStack>
		<HomePage />
		<ProjectsPage />
		<ContactPage />
	</PageStack>
  </body>
</html>
