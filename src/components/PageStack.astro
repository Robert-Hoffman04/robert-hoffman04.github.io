---
import LiquidNav from "./LiquidNav.astro";
import HomeIcon from "../icons/home.svg?raw";
import BriefcaseIcon from "../icons/briefcase.svg?raw";
import AtIcon from "../icons/at.svg?raw";

const items = [
    { label: "Home", href: "#home", icon: HomeIcon },
    { label: "Projects", href: "#projects", icon: BriefcaseIcon },
    { label: "Contact", href: "#contact", icon: AtIcon },
];

interface Props {
    /**
     * How long the page transition should take, in milliseconds.
     */
    duration?: number;
}

const { duration = 700 } = Astro.props;
---

<div
    id="page-stack"
    class="fixed inset-0 overflow-hidden bg-black"
    style={`--page-transition-duration: ${duration}ms;`}
>
    <div id="pages" class="relative h-full w-full">
        <slot />
    </div>

    <!-- Side navigation -->
    <nav
        id="page-navigation"
        class="fixed right-6 top-1/2 z-50 -translate-y-1/2 md:right-10"
        aria-label="Page navigation"
    >
        <LiquidNav
            items={items}
            activeIndex={0}
            orientation="vertical"
            popupSide={false}
        />
    </nav>
</div>

<script>
    const stack = document.querySelector("#page-stack");
    const pagesContainer = document.querySelector("#pages");
    const navigation = document.querySelector("#page-navigation");

    if (!stack || !pagesContainer || !navigation) {
        throw new Error("PageStack: required elements not found.");
    }

    const pages = Array.from(pagesContainer.children) as HTMLElement[];

    if (pages.length === 0) {
        throw new Error("PageStack: no pages found.");
    }

    const transitionDuration = parseInt(getComputedStyle(stack).getPropertyValue("--page-transition-duration")) || 700;

    let currentPage = 0;
    let isAnimating = false;

    pages.forEach((page, index) => {
        page.classList.add(
            "absolute",
            "inset-0",
            "h-full",
            "w-full",
            "overflow-y-auto",
            "overflow-x-hidden",
            "overscroll-contain",
        );

        page.style.transition = `transform ${transitionDuration}ms cubic-bezier(.77,0,.18,1)`;
        page.style.transform = index === 0 ? "translateY(0)" : "translateY(100%)";
        page.style.zIndex = String(index + 1);
        page.setAttribute("data-page-index", String(index));
        page.style.overscrollBehaviorY = "contain";
    });

    const navLinks = Array.from(
        navigation.querySelectorAll(".lg-nav__item"),
    ) as HTMLAnchorElement[];

    const navEl = navigation.querySelector(".lg-nav") as HTMLElement | null;

    function updateNavigation() {
        navLinks.forEach((link, index) => {
            if (index === currentPage) {
                link.setAttribute("aria-current", "page");
            } else {
                link.removeAttribute("aria-current");
            }
        });

        navEl?.dispatchEvent(
            new CustomEvent("liquidnav:setactive", {
                detail: { index: currentPage },
            }),
        );
    }

    function goToPage(targetIndex: number) {
        if (
            isAnimating ||
            targetIndex < 0 ||
            targetIndex >= pages.length ||
            targetIndex === currentPage
        ) {
            return;
        }

        isAnimating = true;

        const direction = targetIndex > currentPage ? 1 : -1;

        const current = pages[currentPage];
        const target = pages[targetIndex];

        target.style.zIndex = String(pages.length + 1);
        target.style.transform = `translateY(${direction * 100}%)`;
        target.getBoundingClientRect();
        current.style.transform = `translateY(${-direction * 100}%)`;
        target.style.transform = "translateY(0)";

        currentPage = targetIndex;

        updateNavigation();

        window.setTimeout(() => {
            pages.forEach((page, index) => {
                if (index !== currentPage) {
                    page.style.zIndex = String(index + 1);
                }
            });

            isAnimating = false;
        }, transitionDuration);
    }

    navLinks.forEach((link, index) => {
        link.addEventListener("click", (event) => {
            event.preventDefault();

            goToPage(index);
        });
    });

    updateNavigation();
</script>
