---
import LiquidNav from "./LiquidNav.astro";
import HomeIcon from "../icons/home.svg?raw";
import BriefcaseIcon from "../icons/briefcase.svg?raw";
import AtIcon from "../icons/at.svg?raw";

const items = [
    { label: "Home", href: "/", icon: HomeIcon },
    { label: "Projects", href: "/projects", icon: BriefcaseIcon },
    { label: "Contact", href: "/contact", icon: AtIcon },
];

// Built pages are served as "/projects/", the dev server as "/projects".
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const activeIndex = Math.max(
    0,
    items.findIndex((item) => item.href === currentPath),
);
---

<nav
    id="page-navigation"
    class="fixed inset-x-0 bottom-6 z-50 flex justify-center md:inset-x-auto md:bottom-auto md:right-6 md:top-1/2 md:-translate-y-1/2 md:right-10"
    aria-label="Page navigation"
>
    <LiquidNav
        items={items}
        activeIndex={activeIndex}
        orientation="vertical"
        popupSide={false}
        responsive
    />
</nav>
