---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<canvas class:list={["scene-backdrop", className]} aria-hidden="true"></canvas>

<style>
  .scene-backdrop {
    position: fixed;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    animation: background-fade 0.6s ease-out forwards;
  }

  /* Set while a 3D foreground item on the stage accepts pointer input. */
  .scene-backdrop.is-interactive {
    z-index: 0;
    pointer-events: auto;
    touch-action: none;
    cursor: grab;
  }

  .scene-backdrop.is-interactive:active {
    cursor: grabbing;
  }

  @keyframes background-fade {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-backdrop {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  import { getStage } from "../lib/sceneStage";

  getStage();
</script>
